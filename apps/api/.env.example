# URL de conexao Neon/PostgreSQL. Nunca versione um valor real.
VIAJAUFSC_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?ssl=require

# Conexao direta (sem -pooler) reservada para migrations Alembic.
VIAJAUFSC_DATABASE_URL_UNPOOLED=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?ssl=require

# Lista JSON de origens permitidas para o futuro frontend React.
VIAJAUFSC_CORS_ORIGINS=["http://localhost:5173"]
